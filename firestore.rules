rules_version = '2';

// - أي زائر يقدر "يضيف" طلب تقديم أو تسليم عمل فقط (بعد التحقق من الحقول).
// - القراءة والحذف للأدمن بس (حساب Firebase Authentication بإيميل الأدمن).
// - مفيش تعديل لأي حد.
service cloud.firestore {
  match /databases/{database}/documents {

    // لازم يكون نفس الإيميل المستخدم في صفحة /admin (VITE_ADMIN_EMAIL)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@super-creative.app';
    }

    match /registrations/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['fullName', 'phone', 'school', 'grade', 'talent', 'consent', 'createdAt']) &&
        request.resource.data.keys().hasAll(
          ['fullName', 'phone', 'school', 'grade', 'talent', 'consent', 'createdAt']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 3 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^01[0125][0-9]{8}$') &&
        request.resource.data.school is string &&
        request.resource.data.school.size() >= 2 &&
        request.resource.data.school.size() <= 100 &&
        request.resource.data.grade is string &&
        request.resource.data.grade.size() >= 1 &&
        request.resource.data.grade.size() <= 30 &&
        request.resource.data.talent in [
          'رسم',
          'تصميم',
          'غناء',
          'تصوير',
          'هاند ميد',
          'تمثيل',
          'فن بصري وتصميم',
          'وسائط رقمية',
          'التصوير',
          'الأداء والصوت',
          'أعمال يدوية وتطبيقية'
        ] &&
        request.resource.data.consent == true &&
        request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // تسليم الأعمال (صفحة /submission): إضافة للجميع بعد التحقق، قراءة/حذف للأدمن بس
    match /submissions/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['student_name', 'category', 'participation_type', 'work_title', 'idea', 'work_link', 'created_at']) &&
        request.resource.data.keys().hasAll(
          ['student_name', 'category', 'participation_type', 'work_title', 'idea', 'work_link', 'created_at']) &&
        request.resource.data.student_name is string &&
        request.resource.data.student_name.size() >= 3 &&
        request.resource.data.student_name.size() <= 100 &&
        request.resource.data.category in ['drawing', 'design', 'acting', 'singing', 'handmade'] &&
        request.resource.data.participation_type in ['team', 'individual'] &&
        request.resource.data.work_title is string &&
        request.resource.data.work_title.size() >= 2 &&
        request.resource.data.work_title.size() <= 100 &&
        request.resource.data.idea is string &&
        request.resource.data.idea.size() >= 20 &&
        request.resource.data.idea.size() <= 1000 &&
        request.resource.data.work_link is string &&
        request.resource.data.work_link.size() <= 500 &&
        request.resource.data.work_link.matches(
          '^https://(drive[.]google[.]com|docs[.]google[.]com|(www[.])?youtube[.]com|youtu[.]be)/.+') &&
        request.resource.data.created_at == request.time;

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // أي مسار تاني: ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
