# انسخ الملف ده باسم .env وحط قيم Firebase بتاعتك
# (Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# إيميل الأدمن (اختياري — الافتراضي admin@super-creative.app).
# لازم يطابق المستخدم اللي بتعمله في Firebase Authentication وملف firestore.rules.
# VITE_ADMIN_EMAIL=admin@super-creative.app

# اختياري: لو هتستخدم دومين خاص (لصورة المعاينة على واتساب). على Vercel بيتحدد تلقائيًا.
# VITE_SITE_URL=https://apply.example.com
